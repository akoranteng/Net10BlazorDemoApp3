@page "/products/edit/{id:int}"
@using Net10BlazorDemoApp3.Models
@using Net10BlazorDemoApp3.Data
@inject ProductService ProductService
@inject NavigationManager NavigationManager

<h3>Edit Product</h3>

@if (product is not null)
{
    <EditForm Model="product"
              OnValidSubmit="SaveChanges"
              FormName="EditProductForm">





        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Name:</label>
            <InputText @bind-Value="product.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Description:</label>
            <InputText @bind-Value="product.Description" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Category:</label>
            <InputText @bind-Value="product.Category" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Price:</label>
            <InputNumber @bind-Value="product.Price" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Cancel</button>
    </EditForm>
}
else
{
    <p>Product not found.</p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;

    protected override void OnInitialized()
    {
        product = ProductService.GetProductById(Id);
        Console.WriteLine($"DEBUG: Id = {Id}");
    }

    private void SaveChanges()
    {
        if (product is not null)
        {
            ProductService.UpdateProduct(product);
        }

        NavigationManager.NavigateTo("/products");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/products");
    }
}